mdl 1.7;
import ::df::*;

// Smooth dielectric with Beer-Lambert volume absorption (wine_pouring/render.py): glass walls and liquids.
// absorption: natural-log absorption coefficient per metre for R, G, B (wine: its A620/A520/A420 per cm x ln 10 x 100).
export material WinePouringDielectric(
    uniform color absorption = color(0.0),
    uniform float dielectric_ior = 1.5
) = material(
    thin_walled: false,
    surface: material_surface(scattering: df::specular_bsdf(tint: color(1.0), mode: df::scatter_reflect_transmit)),
    volume: material_volume(absorption_coefficient: absorption),
    ior: color(dielectric_ior)
);
