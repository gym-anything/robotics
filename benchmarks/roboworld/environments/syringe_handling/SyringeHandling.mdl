mdl 1.7;
import ::df::*;
import ::math::*;
import ::scene::*;
import ::base::*;
import ::state::*;
import ::OmniSurface::OmniSurfaceBase::*;

// Render-only appearance of syringe_handling (syringe_handling/render.py). No physics reads these values.

// Smooth dielectric with Beer-Lambert volume absorption (wine_pouring's): syringe barrels, the vial's glass, tubing, and each liquid by its absorption.
// absorption: natural-log absorption coefficient per metre for R, G, B.
export material SyringeHandlingDielectric(
    uniform color absorption = color(0.0),
    uniform float dielectric_ior = 1.5
) = material(
    thin_walled: false,
    surface: material_surface(scattering: df::specular_bsdf(tint: color(1.0), mode: df::scatter_reflect_transmit)),
    volume: material_volume(absorption_coefficient: absorption),
    ior: color(dielectric_ior)
);

// The mixture's surface. Per-vertex primvars written by the client from each point's composition (render.point_look):
//   displayColor  linear RGB of the material at the vertex
//   gloss         0 = dry powder (matte, no highlight) .. 0.7 = batter or paste (satin, a soft wet coat)
//                 .. 1 = a liquid (a smooth, mirror-like wet coat)
//   trans         0 = opaque .. 1 = gelatinised starch gel (a clearer, sharper coat; the colour itself carries the rest)
export material SyringeHandlingSurface(
    color fallback = color(0.80, 0.74, 0.60)
) = let {
    color base = scene::data_lookup_color("displayColor", fallback);
    float g = math::saturate(scene::data_lookup_float("gloss", 0.0));
    float tr = math::saturate(scene::data_lookup_float("trans", 0.0));
    float sharp = math::max(math::smoothstep(0.30, 1.0, g), tr);
    // a dry powder's surface is grains, not a film: a fine noise in the shading normal that fades as it wets
    // (the bump's strength must be uniform in MDL: the per-vertex share is taken by blending the normals)
    float grain = 1.0 - math::smoothstep(0.05, 0.40, g);
    float3 rough_n = base::perlin_noise_bump_texture(
        uvw: base::coordinate_source(coordinate_system: base::texture_coordinate_world),
        factor: 0.35, size: 0.0016, noise_levels: 3, absolute_noise: false, ridged_noise: false);
    float3 nrm = math::normalize(math::lerp(state::normal(), rough_n, grain));
} in OmniSurface::OmniSurfaceBase::OmniSurfaceBase(
    diffuse_reflection_weight: 1.0,
    diffuse_reflection_color: base,
    diffuse_reflection_roughness: 0.5*(1.0 - g),
    specular_reflection_weight: math::lerp(0.04, 0.50, g),
    specular_reflection_roughness: math::lerp(0.90, 0.30, g),
    specular_reflection_ior: 1.40,
    coat_weight: math::smoothstep(0.15, 0.60, g),
    coat_roughness: math::lerp(0.22, 0.03, sharp),
    coat_ior: 1.34,
    geometry_normal: nrm
);
